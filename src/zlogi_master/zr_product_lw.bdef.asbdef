managed implementation in class zbp_r_product_lw unique;
strict ( 2 );
with draft;

define behavior for zr_product_lw alias Product
persistent table zlogi_product
draft table zlogi_product_d
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed ) ProductUUID;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedBy, LocalLastChangedAt;
  field ( mandatory ) ProductCode, ProductName, BaseUnit;

  // VALIDACIONES, DETERMINACIONES, ACCIONES
  determination SetProductCodeUppercase on modify
  {
    create;
    field ProductCode;
  }

  determination SetProductActive on modify
  {
    create;
  }

  validation ValidateProductCode on save
  {
    create;
    update;
    field ProductCode;
  }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { validation ValidateProductCode ; }

  mapping for zlogi_product
    {
      ProductUUID        = product_uuid;
      ProductCode        = product_code;
      ProductName        = product_name;
      Description        = description;
      BaseUnit           = base_unit;
      Barcode            = barcode;
      IsActive           = is_active;
      CreatedBy          = created_by;
      LastChangedBy      = last_changed_by;
      LocalLastChangedBy = local_last_changed_by;
      CreatedAt          = created_at;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}