managed implementation in class zbp_r_units_meas unique;
strict ( 2 );
with draft;

define behavior for zr_units_meas alias UnitsMeasure
persistent table zlogi_unit_meas
draft table zlogi_unit_mea_d
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( mandatory : create, readonly : update )
  UnitCode;

  field ( readonly )
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedBy,
  LocalLastChangedAt;

  field ( mandatory )
  UnitName;

  //VALIDACIONES, DETERMINACIONES, ACCIONES
  determination SetUnitActive on modify
  {
    create;
  }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;


  mapping for zlogi_unit_meas
    {
      UnitCode           = unit_code;
      UnitName           = unit_name;
      UnitSymbol         = unit_symbol;
      Description        = description;
      IsActive           = is_active;
      CreatedBy          = created_by;
      LastChangedBy      = last_changed_by;
      LocalLastChangedBy = local_last_changed_by;
      CreatedAt          = created_at;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}