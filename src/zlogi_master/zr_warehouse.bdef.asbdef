managed implementation in class zbp_r_warehouse unique;
strict ( 2 );
with draft;
with cross associations;

define behavior for zr_warehouse alias Warehouse
persistent table zlogi_warehouse
draft table zlogi_warehous_d
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create ( authorization : global );
  update;
  delete;

  //  ASOCIACIOINES
  association _StorageBin
  {
    create ( authorization : global );
    with draft;
  }


  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedBy, LocalLastChangedAt;
  field ( readonly, numbering : managed ) WarehouseUUID;
  field ( mandatory ) WarehouseCode;
  field ( mandatory ) WarehouseName;

  //  VALIDACIONES, DETERMINACIONES, ACCIONES
  //  Validar el código de almacén
  validation ValidateWarehouseCode on save { create; update; field WarehouseCode; }


  //  Establecer el código de Almacén a Mayúsculas
  determination SetWarehouseCodeUppercase on modify
  {
    create;
    field WarehouseCode;
  }

  //Activar el Almacén automáticamente al crearse
  determination SetWarehouseActive on modify
  {
    create;
  }

  //ACCIONES DRAFT
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { validation ValidateWarehouseCode; }


  mapping for zlogi_warehouse
    {
      WarehouseUUID      = warehouse_uuid;
      WarehouseCode      = warehouse_code;
      WarehouseName      = warehouse_name;
      Description        = description;
      City               = city;
      Country            = country;
      IsActive           = is_active;
      CreatedBy          = created_by;
      LastChangedBy      = last_changed_by;
      LocalLastChangedBy = local_last_changed_by;
      CreatedAt          = created_at;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for zr_storage_bin alias StorageBin
persistent table zlogi_stor_bin
draft table zlogi_stor_bin_d
lock dependent by _Warehouse
authorization dependent by _Warehouse
etag master LocalLastChangedAt
{
  update;
  delete;

  determination SetStorageBinActive on modify { create; }

  field ( readonly, numbering : managed ) StorageBinUUID;

  field ( readonly )
  WarehouseUUID,
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedBy,
  LocalLastChangedAt;

  field ( mandatory ) StorageBinCode;
  field ( mandatory ) StorageBinName;
  field ( mandatory ) StorageTypeUUID;

  association _Warehouse { with draft; }
  association _StorageType;

  mapping for zlogi_stor_bin
    {
      StorageBinUUID     = storage_bin_uuid;
      WarehouseUUID      = warehouse_uuid;
      StorageTypeUUID    = storage_type_uuid;
      StorageBinCode     = storage_bin_code;
      StorageBinName     = storage_bin_name;
      AisleCode          = aisle_code;
      RackCode           = rack_code;
      LevelCode          = level_code;
      PositionCode       = position_code;
      Description        = description;
      IsActive           = is_active;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
    }
}