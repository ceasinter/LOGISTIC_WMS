projection;
strict ( 2 );
use draft;

define behavior for zc_warehouse alias Warehouse
{
  use create;
  use update;
  use delete;
  use association _StorageBin { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for zc_storage_bin alias StorageBin
{
  use update;
  use delete;

  use association _Warehouse { with draft; }
  use association _StorageType;
}