@Metadata.layer:#CORE

@UI.headerInfo: {
    typeName: 'EstatusTransition',
    typeNamePlural: 'StatusTransitions',
    title: {
        type: #STANDARD,
        value: 'ProcessCode'
    },
    description: {
        value: 'ProcessCode'
    }
}

annotate entity zc_status_transition with
{

  //CREACIÓN DE PESTAÑAS PARA LA PANTALLA DE DETALLE
  @UI.facet: [{
      id: 'EstatusTransition',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Estátus Transition',
      position: 10 }]


  @UI.lineItem: [{ position: 20, label: 'Proceso' }]
  @UI.selectionField: [{ position: 20 }]
  @EndUserText.label: 'Código Proceso'
  @UI.identification: [{ position: 20 }]
  ProcessCode;

  @UI.lineItem: [{ position: 30, label: 'Código Estátus' }]
  @UI.selectionField: [{ position: 30 }]
  @EndUserText.label: 'Código Estátus'
  @UI.identification: [{ position: 30 }]
//  @UI.hidden: true
  FromStatus;

  @UI.lineItem: [
  { position: 40, label: 'Estátus origen' }
  ]
  @UI.selectionField: [{ position: 30 }]
  @EndUserText.label: 'Estátus Origen'
  FromStatusDescription;

  @UI.lineItem: [{ position: 50, label: 'Código Estátus' }]
  @UI.selectionField: [{ position: 50 }]
  @EndUserText.label: 'Código Estátus'
  @UI.identification: [{ position: 50 }]
//  @UI.hidden: true
  ToStatus;

  @UI.lineItem: [
  { position: 60, label: 'Estátus Destino' }
  ]
  @UI.selectionField: [{ position: 40 }]
  @EndUserText.label: 'Estátus Destino'
  ToStatusDescription;

  @UI.lineItem: [{ position: 70, label: 'Permitido' }]
  @UI.selectionField: [{ position: 70 }]
  @EndUserText.label: 'Permitido'
  @UI.identification: [{ position: 70 }]
  IsAllowed;

  @UI.identification: [{ position: 80 }]
  CreatedBy;
  @UI.identification: [{ position: 90 }]
  LastChangedBy;
  @UI.identification: [{ position: 100 }]
  LocalLastChangedBy;
  @UI.identification: [{ position: 110 }]
  CreatedAt;
  @UI.identification: [{ position: 120 }]
  LastChangedAt;
  @UI.identification: [{ position: 130 }]
  LocalLastChangedAt;

}