@Metadata.layer:#CORE

@UI.headerInfo: {
    typeName: 'EstatusTransition',
    typeNamePlural: 'StatusTransition',
    title: {
        type: #STANDARD,
        value: 'ProcessCode'
    },
    description: {
        value: 'ProcessCode'
    }
}

annotate entity zc_status_transition with
{

  //CREACIÓN DE PESTAÑAS PARA LA PANTALLA DE DETALLE
  @UI.facet: [{
      id: 'EstatusTransition',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Estátus Transition',
      position: 10 }]


  @UI.lineItem: [{ position: 20, label: 'Proceso' }]
  @UI.selectionField: [{ position: 20 }]
  @EndUserText.label: 'Código Proceso'
  @UI.identification: [{ position: 20 }]
  ProcessCode;

  @UI.lineItem: [{ position: 30, label: 'Estátus Desde' }]
  @UI.selectionField: [{ position: 30 }]
  @EndUserText.label: 'Estátus Desde'
  @UI.identification: [{ position: 30 }]
  FromStatus;

  @UI.lineItem: [{ position: 40, label: 'Estátus Hasta' }]
  @UI.selectionField: [{ position: 40 }]
  @EndUserText.label: 'Estátus Hasta'
  @UI.identification: [{ position: 40 }]
  ToStatus;

  @UI.lineItem: [{ position: 50, label: 'Activo' }]
  @UI.selectionField: [{ position: 50 }]
  @EndUserText.label: 'Activo'
  @UI.identification: [{ position: 50 }]
  IsActive;

  @UI.identification: [{ position: 60 }]
  CreatedBy;
  @UI.identification: [{ position: 70 }]
  LastChangedBy;
  @UI.identification: [{ position: 80 }]
  LocalChangedBy;
  @UI.identification: [{ position: 90 }]
  CreatedAt;
  @UI.identification: [{ position: 100 }]
  LastChangedAt;
  @UI.identification: [{ position: 110 }]
  LocalChangedAt;

}