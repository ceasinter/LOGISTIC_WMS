managed implementation in class zbp_r_status_transition unique;
strict ( 2 );
with draft;

define behavior for zr_status_transition alias StatusTransition
persistent table zlogi_t_sttrans
draft table zlogi_t_sttran_d
lock master
total etag LastChangedAt

authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly : update ) ProcessCode, FromStatus, ToStatus;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedBy, LocalLastChangedAt;

  //VALIDACIONES, ACCIONES, DETERMINACIONES Y LÓGICA
  validation ValidateTransition on save { create; update; }
  validation ValidateStatusExistence on save { create; update; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  { validation ValidateTransition;
    validation ValidateStatusExistence; }

  mapping for zlogi_t_sttrans
    {
      ProcessCode        = process_code;
      FromStatus         = from_status;
      ToStatus           = to_status;
      IsAllowed          = is_allowed;
      CreatedBy          = created_by;
      LastChangedBy      = last_changed_by;
      LocalLastChangedBy = local_last_changed_by;
      CreatedAt          = created_at;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}