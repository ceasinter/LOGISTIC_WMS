managed implementation in class zbp_r_stock_type unique;
strict ( 2 );
with draft;

define behavior for zr_stock_type alias StockType
persistent table zlogi_stock_type
draft table zlogi_stock_t_d
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;
  field ( readonly, numbering : managed ) StockTypeUUID;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedBy, LocalLastChangedAt;

  field ( mandatory ) StockTypeCode;
  field ( mandatory ) StockTypeName;

  //  VALIDACIONES, DETERMINACIONES, ACCIONES
  determination SetStockTypeActive on modify { create; }
  determination SetStockTypeCodeUppercase on modify
  {
    create;
    field StockTypeCode;
  }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;


  mapping for zlogi_stock_type
    {
      StockTypeUUID      = stock_type_uuid;
      StockTypeCode      = stock_type_code;
      StockTypeName      = stock_type_name;
      Description        = description;
      IsPickable         = is_pickable;
      RequiresQuality    = requires_quality;
      IsBlocked          = is_blocked;
      IsActive           = is_active;
      CreatedBy          = created_by;
      LastChangedBy      = last_changed_by;
      LocalLastChangedBy = local_last_changed_by;
      CreatedAt          = created_at;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}